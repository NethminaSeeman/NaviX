# NaviX backend — Cloudflare Worker via Wrangler (local Miniflare mode)
#
# This image is for LOCAL DEVELOPMENT only. Production deploys to
# Cloudflare Workers (see README.md → Cloudflare deployment).
FROM node:22-slim

WORKDIR /app

# ── Install dependencies via workspace root ───────────────────────────────────
# The project uses npm workspaces so the lock file lives at the repo root.
# We copy all workspace manifests first for optimal layer caching, then
# install only the backend workspace to keep the image small.
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json  ./backend/package.json

# Full install so wrangler's workerd binary postinstall scripts run correctly
RUN npm ci

# ── Copy source into the backend workspace directory ─────────────────────────
WORKDIR /app/backend
COPY backend/ ./

# Copy place data for optional seeding scripts
COPY data/ /data/

# Entrypoint: generates .dev.vars from env, runs migrations, starts Wrangler
COPY docker-entrypoint.sh /entrypoint.sh
# Strip Windows CR line endings and make executable
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 8787
ENTRYPOINT ["/entrypoint.sh"]
