{
  "name": "ceygo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "backend:dev": "npm --prefix backend run dev",
    "backend:deploy": "npm --prefix backend run deploy",
    "deploy:backend": "npm --prefix backend run cf:deploy:all",
    "deploy:frontend": "npm --prefix frontend run build && npm --prefix backend exec wrangler pages deploy ../frontend/dist --project-name=navix-frontend",
    "deploy:all": "npm run deploy:backend && npm run deploy:frontend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@google/genai": "^2.3.0",
    "mongodb": "^7.2.0"
  }
}
