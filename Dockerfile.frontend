# ── Stage 1: install dependencies via workspace root ──────────────────────────
# The project uses npm workspaces — the lock file lives at the repo root.
FROM node:22-alpine AS deps
WORKDIR /app

# Copy workspace root manifests first (best layer-cache behaviour)
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json  ./backend/package.json

# Install only the frontend workspace (keeps image lean)
RUN npm ci --workspace=frontend --ignore-scripts

# ── Stage 2: development (Vite HMR) ───────────────────────────────────────────
FROM deps AS dev
WORKDIR /app/frontend
COPY frontend/ ./
EXPOSE 5173
CMD ["node", "/app/node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173"]

# ── Stage 3: production build ─────────────────────────────────────────────────
FROM deps AS builder
WORKDIR /app/frontend
COPY frontend/ ./

# Build-time env vars are baked into the static bundle by Vite
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_GOOGLE_CLIENT_ID

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN node /app/node_modules/.bin/vite build

# ── Stage 4: production server (nginx) ────────────────────────────────────────
FROM nginx:1.27-alpine AS production
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
