# ─────────────────────────────────────────────────────────────
# NaviX Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local  →  cp .env.example .env.local
# 2. Fill in your real values below
# 3. Never commit .env.local to git
# ─────────────────────────────────────────────────────────────

# Backend API URL
#
# Local development options:
#   - Cloudflare Worker (wrangler dev):  http://127.0.0.1:8787
#   - Legacy FastAPI:                    http://localhost:8000
#
# Production (Cloudflare Worker):
#   https://navix-api.<your-subdomain>.workers.dev
#
# To change the deployed URL on Cloudflare Pages:
#   1. Cloudflare dashboard -> Workers & Pages -> navix-frontend
#   2. Settings -> Environment variables (Production AND Preview)
#   3. Set VITE_API_BASE_URL to the Worker URL above
#   4. Deployments -> "Retry deployment" on the latest build so Vite
#      bakes the new value into the static bundle
VITE_API_BASE_URL=http://127.0.0.1:8787

# Google Maps JavaScript API Key
# 1. Go to https://console.cloud.google.com/
# 2. APIs & Services → Credentials → your API key
# 3. Under "Application restrictions" → HTTP referrers (websites)
# 4. Add ALL domains that will serve the app, e.g.:
#      http://localhost:5173/*
#      http://localhost:4173/*
#      https://your-app.vercel.app/*
#      https://*.your-custom-domain.com/*
# 5. Under "API restrictions" → ensure "Maps JavaScript API" is enabled
# 6. Save and wait ~5 minutes for changes to propagate
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Sign-In (Identity Services) — same OAuth 2.0 Web Client ID as Worker GOOGLE_CLIENT_ID
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web client
# Authorised JavaScript origins: http://localhost:5173, https://your-pages-domain.pages.dev
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here.apps.googleusercontent.com
