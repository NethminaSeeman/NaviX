# ─────────────────────────────────────────────────────────────────────────────
# NaviX — Docker Compose environment variables
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ─────────────────────────────────────────────────────────────────

# URL the browser uses to reach the backend API.
# Dev (Docker):  http://localhost:8787
# Production:    https://navix-api.<subdomain>.workers.dev
VITE_API_BASE_URL=http://localhost:8787

# Google Maps JavaScript API key (Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Web Client ID (must match GOOGLE_CLIENT_ID below)
VITE_GOOGLE_CLIENT_ID=

# ── Backend (Cloudflare Worker secrets) ───────────────────────────────────────

# Primary LLM: OpenAI (gpt-4o-mini). Recommended.
OPENAI_API_KEY=

# Fallback LLM: Google Gemini (gemini-1.5-flash)
GEMINI_API_KEY=

# OpenWeatherMap API key (optional — mock weather returned if omitted)
WEATHER_API_KEY=

# Google OAuth Web Client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# One-time secret for POST /admin/bootstrap (create the first admin account).
# Use a long random string. After first admin is created the endpoint locks.
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-long-random-string

# ── Stripe billing (optional — skip if not using paid plans) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Frontend base URL embedded in Stripe redirect URLs
APP_BASE_URL=http://localhost:5173
