{
  "name": "navix-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply navix-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply navix-db --remote",
    "d1:seed:generate": "node ./scripts/json-to-d1-seed.mjs",
    "d1:seed:generate:legacy": "node ./scripts/mongo-to-d1-seed.mjs ../data/mongodb/places.sample.json ./migrations/0002_seed_places.sql",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:secrets": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-secrets.ps1",
    "cf:deploy:all": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-all.ps1",
    "pages:deploy": "npm run build --prefix ../frontend && npx wrangler pages deploy ../frontend/dist --project-name=navix-frontend"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.86.0"
  }
}
