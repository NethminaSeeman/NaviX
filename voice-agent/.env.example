LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required for the Gemini Live API model.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# NaviX Cloudflare Worker base URL (no trailing slash).
# Local: http://127.0.0.1:8787
# Production: https://navix-api.<your-subdomain>.workers.dev
NAVIX_API_BASE_URL=http://127.0.0.1:8787

# Optional: fallback Bearer token if the browser participant has no navixToken metadata.
# Prefer passing the logged-in user's token via /voice/token metadata instead.
# NAVIX_SERVICE_TOKEN=
